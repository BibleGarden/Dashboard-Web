# Alignment API
# Required, no fallback — vite.config.js fails to start without it.
VITE_ALIGNMENT_API_TARGET=http://localhost:8002

# Admin API (Dashboard-API)
# Required, no fallback — vite.config.js fails to start without it.
VITE_ADMIN_API_TARGET=http://localhost:8085/api
# Required, no fallback — the app refuses to mount without it (see src/config/api.ts).
VITE_ADMIN_API_KEY=your_api_key_here
